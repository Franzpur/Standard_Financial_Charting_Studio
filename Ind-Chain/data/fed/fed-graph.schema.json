{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fed-graph.schema.json",
  "title": "FED institutional graph",
  "type": "object",
  "required": ["nodes", "edges", "edge_types", "departments", "fund_flow_subtypes", "scenarios"],
  "properties": {
    "version": { "type": "integer" },
    "updated": { "type": "string" },
    "fund_flow_subtypes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "zh", "en"],
        "properties": {
          "key": { "type": "string" },
          "zh": { "type": "string" },
          "en": { "type": "string" }
        }
      }
    },
    "account_types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "zh", "en"],
        "properties": {
          "key": { "type": "string" },
          "zh": { "type": "string" },
          "en": { "type": "string" }
        }
      }
    },
    "edge_types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "zh", "core8"],
        "properties": {
          "key": { "type": "string" },
          "zh": { "type": "string" },
          "core8": { "type": "boolean" }
        }
      }
    },
    "departments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "zh", "en", "order"],
        "properties": {
          "key": { "type": "string" },
          "zh": { "type": "string" },
          "en": { "type": "string" },
          "order": { "type": "integer" }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "scenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["doc", "status"],
      "properties": {
        "doc": { "type": "string" },
        "pdf_pages": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "status": { "enum": ["verified", "derived", "external"] },
        "note": { "type": "string" },
        "fig": { "type": "string" }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "class", "kind", "label", "ring", "dept", "evidence"],
      "properties": {
        "id": { "type": "string" },
        "class": { "enum": ["governance", "bank", "committee", "external"] },
        "kind": { "type": "string" },
        "dept": { "type": "string" },
        "label": {
          "type": "object",
          "required": ["zh", "en"],
          "properties": { "zh": { "type": "string" }, "en": { "type": "string" } }
        },
        "ring": { "type": "integer", "minimum": 0, "maximum": 4 },
        "attrs": { "type": "object" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "type", "from", "to", "directed", "evidence"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "subtype": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "directed": { "type": "boolean" },
        "label": { "type": "string" },
        "meaning": { "type": "string" },
        "attrs": { "type": "object" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "scenario": {
      "type": "object",
      "required": ["id", "steps"],
      "properties": {
        "id": { "type": "string" },
        "zh": { "type": "string" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["order", "caption", "nodes", "edges", "pdf_pages"],
            "properties": {
              "order": { "type": "integer" },
              "caption": { "type": "string" },
              "nodes": { "type": "array", "items": { "type": "string" } },
              "edges": { "type": "array", "items": { "type": "string" } },
              "pdf_pages": { "type": "array", "items": { "type": "integer" } }
            }
          }
        }
      }
    }
  }
}
